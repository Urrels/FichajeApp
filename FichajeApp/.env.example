# Copiá este archivo como .env y completalo. NO subas .env a git.

# Dirección pública del servidor (sin https://). Ej.: fichaje-sol.duckdns.org
DOMINIO=fichaje-micliente.duckdns.org

# Clave que firma las sesiones: 32 o más caracteres al azar, DISTINTA para cada cliente.
JWT_SECRET=cambiame-por-una-clave-larga-y-al-azar-de-32-o-mas-caracteres

# Código de activación que le mandás al cliente para conectar su planilla desde la app.
CODIGO_ACTIVACION=elegi-un-codigo-para-este-cliente

# Días que se guardan las fotos de los fichajes (0 = no borrar nunca)
DIAS_FOTOS=90