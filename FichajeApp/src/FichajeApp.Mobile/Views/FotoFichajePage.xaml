<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FichajeApp.Mobile.Views.FotoFichajePage"
             Title="Foto del fichaje"
             BackgroundColor="Black">

    <Grid RowDefinitions="*,Auto,Auto" Padding="16" RowSpacing="12">
        <Image x:Name="Foto" Aspect="AspectFit" />
        <ActivityIndicator x:Name="Cargando" IsRunning="True" HorizontalOptions="Center" VerticalOptions="Center" />
        <Label x:Name="Detalle" Grid.Row="1" TextColor="White" FontSize="15" HorizontalTextAlignment="Center" />
        <!-- Solo si el fichaje tiene ubicación: abre las coordenadas exactas en Google Maps -->
        <Button x:Name="MapsButton" Grid.Row="2" Text="Ver en Google Maps" IsVisible="False" Clicked="OnVerEnMapsClicked"
                HorizontalOptions="Fill" />
    </Grid>
</ContentPage>
