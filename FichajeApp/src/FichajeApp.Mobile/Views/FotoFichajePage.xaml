<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FichajeApp.Mobile.Views.FotoFichajePage"
             Title="Foto del fichaje"
             BackgroundColor="Black">

    <Grid RowDefinitions="*,Auto" Padding="12">
        <Image x:Name="Foto" Aspect="AspectFit" />
        <ActivityIndicator x:Name="Cargando" IsRunning="True" HorizontalOptions="Center" VerticalOptions="Center" />
        <Label x:Name="Detalle" Grid.Row="1" TextColor="White" HorizontalTextAlignment="Center" Margin="0,8,0,0" />
    </Grid>
</ContentPage>
