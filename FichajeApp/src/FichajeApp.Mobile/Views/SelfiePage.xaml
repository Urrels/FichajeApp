<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FichajeApp.Mobile.Views.SelfiePage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="Black">

    <Grid RowDefinitions="*,Auto">

        <!-- La vista de la cámara se agrega por código (ver OnAppearing): así la pantalla y los botones se dibujan
             primero y recién después arranca la cámara, que es lo que más tarda -->
        <Grid x:Name="Escena">
            <Label x:Name="Aviso" Text="Abriendo la cámara…"
                   TextColor="White" FontSize="16" HorizontalOptions="Center" VerticalOptions="Start" Margin="16,48,16,0"
                   HorizontalTextAlignment="Center" />

            <ActivityIndicator x:Name="Ocupado" IsRunning="True" IsVisible="True" Color="White"
                               HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,2*" ColumnSpacing="12" Padding="16,12,16,28" BackgroundColor="#CC000000">
            <Button x:Name="CancelarBoton" Text="Cancelar" Clicked="OnCancelar"
                    BackgroundColor="Transparent" TextColor="White" />
            <Button x:Name="SacarBoton" Grid.Column="1" Text="Sacar foto" Clicked="OnSacar" FontAttributes="Bold"
                    IsEnabled="False" />
        </Grid>
    </Grid>
</ContentPage>
