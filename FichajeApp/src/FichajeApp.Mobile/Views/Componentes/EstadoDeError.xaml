<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FichajeApp.Mobile.Views.Componentes.EstadoDeError"
             x:Name="Raiz">

    <!-- Pantalla de error: se usa cuando la pantalla NO puede cumplir su función (sin conexión al abrir, servidor caído,
         planilla desconectada). Para fallas chicas se usa un snackbar; para decidir algo, un modal. -->
    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="32" Spacing="12">
        <Label Text="{Binding Icono, Source={x:Reference Raiz}}" FontSize="52" HorizontalOptions="Center" />
        <Label Text="{Binding Titulo, Source={x:Reference Raiz}}" FontSize="20" FontAttributes="Bold"
               HorizontalTextAlignment="Center" TextColor="{DynamicResource ColorTexto}" />
        <Label Text="{Binding Mensaje, Source={x:Reference Raiz}}" FontSize="14"
               HorizontalTextAlignment="Center" TextColor="{DynamicResource ColorTextoSuave}" />
        <Button Text="{Binding TextoBoton, Source={x:Reference Raiz}}" Clicked="OnBoton" HorizontalOptions="Center" Margin="0,8,0,0"
                IsVisible="{Binding TieneBoton, Source={x:Reference Raiz}}" />
    </VerticalStackLayout>
</ContentView>
