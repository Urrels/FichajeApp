<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FichajeApp.Mobile.Views.Componentes.EstadoVacio"
             x:Name="Raiz">

    <!-- Para una lista sin elementos: un ícono y una frase que diga qué va a aparecer acá, en vez de una pantalla en blanco -->
    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="32,40" Spacing="8">
        <Label Text="{Binding Icono, Source={x:Reference Raiz}}" FontSize="40" HorizontalOptions="Center" Opacity="0.7" />
        <Label Text="{Binding Titulo, Source={x:Reference Raiz}}" FontSize="16" FontAttributes="Bold"
               HorizontalTextAlignment="Center" TextColor="{DynamicResource ColorTexto}" />
        <Label Text="{Binding Mensaje, Source={x:Reference Raiz}}" FontSize="13"
               HorizontalTextAlignment="Center" TextColor="{DynamicResource ColorTextoSuave}" />
    </VerticalStackLayout>
</ContentView>
