<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ctl="clr-namespace:FichajeApp.Mobile.Views.Componentes"
             x:Class="FichajeApp.Mobile.Views.ConfiguracionPage"
             Title="Conectar Google Sheets"
             BackgroundColor="{DynamicResource ColorFondo}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">

            <Label Text="Conectá tu planilla de Google" FontSize="20" FontAttributes="Bold" />

            <!-- Si la planilla conectada se borró o dejó de estar compartida -->
            <ctl:BannerInline Severidad="Error" Texto="{Binding Aviso}" IsVisible="{Binding HayAviso}" />

            <!-- Todo de una vez: el servidor crea la planilla, la prepara y se la comparte -->
            <Border Style="{StaticResource Tarjeta}" Padding="12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <VerticalStackLayout>
                        <Label Text="Crear la planilla por mí" FontAttributes="Bold" />
                        <Label FontSize="12"
                               Text="Recomendado: se crea una planilla nueva y vacía en Google, se prepara sola y se comparte con tu cuenta. No tenés que crear ni compartir nada." />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" IsToggled="{Binding CrearPlanilla}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Crear: solo hace falta tu cuenta de Google -->
            <VerticalStackLayout IsVisible="{Binding CrearPlanilla}" Spacing="6">
                <Label Text="Tu cuenta de Google" FontAttributes="Bold" Margin="0,6,0,0" />
                <Label FontSize="11" Text="Ahí se te comparte la planilla (la vas a ver en Google Drive, en «Compartidos conmigo», y te llega un mail)." />
                <Entry Text="{Binding EmailPropietario}" Placeholder="tuemail@gmail.com" Keyboard="Email" />
                <Label Text="Nombre de la empresa" FontAttributes="Bold" Margin="0,6,0,0" />
                <Entry Text="{Binding NombreEmpresa}" Placeholder="Por ejemplo: Gimnasio Sol" MaxLength="60" />
            </VerticalStackLayout>

            <!-- A mano: ya tengo una planilla. Caso normal: el servidor ya tiene la cuenta de servicio -->
            <VerticalStackLayout IsVisible="{Binding ModoManual}" Spacing="8">
                <Label FontAttributes="Bold" Text="Paso 1: creá una planilla" Margin="0,6,0,0" />
                <Label FontSize="12" Text="Entrá a Google Sheets con tu cuenta y creá una planilla nueva y vacía (el nombre da igual)." />

                <Label FontAttributes="Bold" Text="Paso 2: compartila con este correo, como Editor" Margin="0,6,0,0" />
                <Border Style="{StaticResource Tarjeta}" Padding="12">
                    <Label Text="{Binding CuentaDeServicio}" FontSize="13" TextColor="{DynamicResource ColorTexto}" />
                </Border>
                <Button Text="Copiar correo" Clicked="OnCopiarCorreo" />

                <Label FontAttributes="Bold" Text="Paso 3: pegá el link de la planilla" Margin="0,6,0,0" />
            </VerticalStackLayout>

            <!-- Servidor sin cuenta de servicio: hay que cargar el .json -->
            <VerticalStackLayout IsVisible="{Binding PideCredencial}" Spacing="8">
                <Label FontSize="12"
                       Text="Este servidor no tiene una cuenta de servicio de Google. Pedile el archivo .json a quien lo instaló (o creá una en Google Cloud)." />
                <Label Text="Credencial de la cuenta de servicio" FontAttributes="Bold" />
                <Button Text="Elegir archivo .json" Clicked="OnElegirArchivo" />
                <Editor Text="{Binding Credenciales}" HeightRequest="90" Placeholder="…o pegá acá el contenido del archivo"
                        IsVisible="{Binding MuestraEditor}" />
                <Label Text="✔ Credencial cargada" IsVisible="{Binding CredencialesCargadas}" />
            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="{Binding PideLink}" Spacing="6">
                <Label Text="Planilla" FontAttributes="Bold" Margin="0,8,0,0" />
                <Entry Text="{Binding Planilla}" Placeholder="Link de tu planilla" Keyboard="Url" />
            </VerticalStackLayout>

            <Label Text="Primer administrador" FontAttributes="Bold" Margin="0,8,0,0" />
            <Label FontSize="11" Text="Con este usuario vas a entrar a la app para administrar todo." />
            <Entry Text="{Binding NombreAdmin}" Placeholder="Nombre y apellido" />
            <Entry Text="{Binding EmailAdmin}" Placeholder="Email (si lo dejás vacío, usa tu cuenta de Google)" Keyboard="Email" />
            <Entry Text="{Binding PinAdmin}" Placeholder="PIN (4 dígitos)" IsPassword="True" Keyboard="Numeric" MaxLength="4" />

            <VerticalStackLayout IsVisible="{Binding PideClave}" Spacing="6">
                <Label Text="Código de activación" FontAttributes="Bold" Margin="0,8,0,0" />
                <Label Text="Te lo envía la empresa que te dio la app." FontSize="11" />
                <Entry Text="{Binding Clave}" IsPassword="True" Placeholder="Código de activación" />
                <Button Text="¿No tenés el código?" Clicked="OnAyudaClave" BackgroundColor="Transparent"
                        TextColor="{DynamicResource ColorTextoSuave}" FontSize="12" />
            </VerticalStackLayout>

            <Button Text="{Binding TextoBotonGuardar}" Clicked="OnGuardar" Margin="0,8,0,0"
                    IsEnabled="{Binding Procesando, Converter={StaticResource InvertedBoolConverter}}" />
            <ActivityIndicator IsRunning="{Binding Procesando}" IsVisible="{Binding Procesando}" />
            <Label Text="{Binding Estado}" HorizontalTextAlignment="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
