<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ctl="clr-namespace:FichajeApp.Mobile.Views.Componentes"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             x:Class="FichajeApp.Mobile.Views.AparienciaPage"
             Title="Apariencia"
             BackgroundColor="{DynamicResource ColorFondo}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="Los cambios los ven todos los usuarios. El ícono de la app en la pantalla de inicio del teléfono no se cambia desde acá: lo fija Android al instalarla."
                   FontSize="12" />

            <Label Text="Nombre que se muestra" FontAttributes="Bold" />
            <material:TextField Text="{Binding Nombre}" MaxLength="40" Title="Nombre de la empresa" />

            <Label Text="Colores" FontAttributes="Bold" Margin="0,6,0,0" />
            <Label Text="Tocá el color que querés cambiar y arrastrá. Toda la app cambia mientras elegís." FontSize="12" />

            <!-- Los tres colores: el que tiene el borde oscuro es el que se está editando abajo -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Border Stroke="{Binding BordePrincipal}" StrokeThickness="2" StrokeShape="RoundRectangle 14" Padding="8">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnEditarPrincipal" /></Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Border BackgroundColor="{Binding PrimarioColor}" WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 22" Stroke="#33000000" StrokeThickness="1" HorizontalOptions="Center" />
                        <Label Text="Principal" FontSize="12" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Stroke="{Binding BordeTexto}" StrokeThickness="2" StrokeShape="RoundRectangle 14" Padding="8">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnEditarTexto" /></Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Border BackgroundColor="{Binding TextoColor}" WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 22" Stroke="#33000000" StrokeThickness="1" HorizontalOptions="Center" />
                        <Label Text="Texto" FontSize="12" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Stroke="{Binding BordeAcento}" StrokeThickness="2" StrokeShape="RoundRectangle 14" Padding="8">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnEditarAcento" /></Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Border BackgroundColor="{Binding AcentoColor}" WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 22" Stroke="#33000000" StrokeThickness="1" HorizontalOptions="Center" />
                        <Label Text="Acento" FontSize="12" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Label Text="{Binding TituloEditando}" FontSize="13" FontAttributes="Bold" />
            <ctl:SelectorDeColor Hex="{Binding HexEditando, Mode=TwoWay}" />

            <Button Text="Que el texto se ajuste solo" Clicked="OnTextoAutomatico" IsVisible="{Binding TextoAutomaticoDisponible}" />
            <Label Text="El texto se ajusta solo para que se lea bien sobre el color principal. Si elegís uno a mano, queda fijo." FontSize="11" />

            <!-- Vuelve a los colores de la marca (borgoña, texto blanco y arena) y los guarda para todos; no toca el nombre ni el logo -->
            <Button Text="Restablecer colores" Style="{StaticResource BotonSecundario}" Clicked="OnRestablecerColores" />

            <ctl:BannerInline Severidad="Error" Texto="{Binding Aviso}" IsVisible="{Binding HayAviso}" />

            <Label Text="Logo" FontAttributes="Bold" Margin="0,6,0,0" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Border WidthRequest="96" HeightRequest="96" StrokeShape="Ellipse" StrokeThickness="0" Padding="0" BackgroundColor="White">
                    <Image Source="{Binding Logo}" Aspect="AspectFill" />
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                    <Button Text="Elegir imagen" Clicked="OnElegirLogo" />
                    <Button Text="Usar el logo original" Clicked="OnQuitarLogo" />
                </VerticalStackLayout>
            </Grid>
            <Label Text="Se achica solo a 256 px y se muestra en un círculo. Mejor si es cuadrada y con el dibujo centrado." FontSize="11" />

            <Label Text="{Binding Estado}" FontSize="12" />

            <Button Text="Guardar" Clicked="OnGuardar" IsEnabled="{Binding PuedeGuardar}" />
            <Button Text="Volver a los originales" Clicked="OnRestaurar" />
            <ActivityIndicator IsRunning="{Binding Procesando}" IsVisible="{Binding Procesando}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
