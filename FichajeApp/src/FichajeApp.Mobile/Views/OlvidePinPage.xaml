<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             xmlns:ctl="clr-namespace:FichajeApp.Mobile.Views.Componentes"
             x:Class="FichajeApp.Mobile.Views.OlvidePinPage"
             Title="Olvidé mi PIN"
             BackgroundColor="{DynamicResource ColorFondo}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label Text="Cambiar mi PIN" Style="{StaticResource TextoTitulo}" />

            <!-- Paso 1: el email -->
            <VerticalStackLayout x:Name="Paso1" Spacing="12">
                <Label Text="Escribí tu email y te mandamos un código para elegir un PIN nuevo." />
                <material:TextField x:Name="EmailEntry" Title="Email" Keyboard="Email" MaxLength="100" />
                <Button x:Name="EnviarButton" Text="Enviarme el código" Clicked="OnEnviarCodigo" />
            </VerticalStackLayout>

            <!-- Paso 2: el código y el PIN nuevo -->
            <VerticalStackLayout x:Name="Paso2" Spacing="12" IsVisible="False">
                <Label x:Name="Indicacion" />
                <material:TextField x:Name="CodigoEntry" Title="Código de 6 dígitos" Keyboard="Numeric" MaxLength="6" />
                <material:TextField x:Name="PinEntry" Title="PIN nuevo (4 dígitos)" IsPassword="True" Keyboard="Numeric" MaxLength="4" />
                <material:TextField x:Name="RepetirEntry" Title="Repetí el PIN nuevo" IsPassword="True" Keyboard="Numeric" MaxLength="4" />
                <Button x:Name="CambiarButton" Text="Cambiar mi PIN" Clicked="OnCambiar" />
                <Button Text="Pedir otro código" Clicked="OnPedirOtro" BackgroundColor="Transparent"
                        TextColor="{DynamicResource ColorTextoSuave}" />
            </VerticalStackLayout>

            <ActivityIndicator x:Name="Espera" IsRunning="False" IsVisible="False" />
            <ctl:BannerInline x:Name="Aviso" Severidad="Error" IsVisible="False" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
