<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FichajeApp.Mobile.Views.FichajePage"
             Title="Fichaje">

    <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

        <Label Text="Registro de Fichaje" FontSize="24" HorizontalOptions="Center" />

        <Label Text="{Binding NombreCompleto}" FontSize="18" HorizontalOptions="Center" FontAttributes="Bold" />

        <Button Text="Fichar"
                Clicked="OnFicharClicked"
                IsEnabled="{Binding Procesando, Converter={StaticResource InvertedBoolConverter}}" />

        <ActivityIndicator IsRunning="{Binding Procesando}" IsVisible="{Binding Procesando}" />

        <Label Text="{Binding Estado}" HorizontalOptions="Center" />

        <!-- Aparece después de un fichaje exitoso -->
        <Button Text="Ver en Google Maps"
                Clicked="OnAbrirMapsClicked"
                IsVisible="{Binding MostrarMapa}" />

    </VerticalStackLayout>
</ContentPage>
