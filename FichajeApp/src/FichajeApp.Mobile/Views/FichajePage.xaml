<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ctl="clr-namespace:FichajeApp.Mobile.Views.Componentes"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:iconos="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
             x:Class="FichajeApp.Mobile.Views.FichajePage"
             Title="Fichaje"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource ColorFondo}">

    <!-- Con pantalla chica o letra grande no entra todo junto: se desliza en vez de pisarse -->
    <ScrollView>
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Cabecera: cliente, empleado y hora -->
        <Border x:Name="Cabecera" Grid.Row="0" StrokeThickness="0" BackgroundColor="{DynamicResource ColorPrimario}"
                StrokeShape="RoundRectangle 0,0,32,32" Padding="24,40,24,24">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="2">
                <Label Text="{DynamicResource NombreCliente}"
                       TextColor="{DynamicResource ColorPrimarioTexto}"
                       Opacity="0.85" FontSize="14" />
                <Label Text="{Binding NombreCompleto, StringFormat='Hola, {0}'}"
                       TextColor="{DynamicResource ColorPrimarioTexto}"
                       FontSize="22" FontAttributes="Bold" />
                <Label x:Name="HoraLabel" Margin="0,12,0,0" FontSize="52" FontAttributes="Bold"
                       TextColor="{DynamicResource ColorPrimarioTexto}" />
                <Label x:Name="FechaLabel" FontSize="14" Opacity="0.85"
                       TextColor="{DynamicResource ColorPrimarioTexto}" />
            </VerticalStackLayout>
                <!-- Tu foto de perfil: tocala para cambiarla -->
                <ctl:AvatarUsuario x:Name="MiFoto" Grid.Column="1" Tamano="60" SobreFondoOscuro="True" VerticalOptions="Start"
                                   SemanticProperties.Description="Tu foto de perfil" SemanticProperties.Hint="Tocá para cambiarla">
                    <ctl:AvatarUsuario.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMiFotoTapped" />
                    </ctl:AvatarUsuario.GestureRecognizers>
                </ctl:AvatarUsuario>
            </Grid>
        </Border>

        <!-- Botón principal de fichaje -->
        <VerticalStackLayout Grid.Row="1" VerticalOptions="Center" Spacing="24" Padding="24">

            <Grid HorizontalOptions="Center" VerticalOptions="Center">
                <!-- Halo que respira detrás del botón (ver OnAppearing) -->
                <Ellipse x:Name="Halo" WidthRequest="250" HeightRequest="250" InputTransparent="True"
                         Fill="{DynamicResource ColorPrimario}" Opacity="0.14" />
                <!-- Botón armado a mano (Border + ícono + texto en una pila centrada): en un Button el ícono se pega arriba y el conjunto queda descentrado -->
                <Border x:Name="BotonFichar" WidthRequest="200" HeightRequest="200" StrokeShape="Ellipse" StrokeThickness="0"
                        Padding="0" BackgroundColor="{DynamicResource ColorPrimario}"
                        SemanticProperties.Description="Fichar" SemanticProperties.Hint="Registra tu entrada o salida">
                    <Border.Shadow>
                        <Shadow Brush="{DynamicResource ColorPrimario}" Offset="0,10" Radius="24" Opacity="0.45" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFicharTapped" />
                    </Border.GestureRecognizers>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding Procesando}" Value="True">
                            <Setter Property="Opacity" Value="0.55" />
                        </DataTrigger>
                    </Border.Triggers>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8" InputTransparent="True">
                        <Label Text="{x:Static iconos:MaterialOutlined.Fingerprint}" FontFamily="MaterialOutlined" FontSize="60"
                               HorizontalOptions="Center" TextColor="{DynamicResource ColorPrimarioTexto}" />
                        <Label x:Name="TextoBoton" Text="{Binding TextoBoton}" FontSize="20" FontAutoScalingEnabled="False" FontAttributes="Bold" HorizontalOptions="Center" LineBreakMode="WordWrap" MaximumWidthRequest="160"
                               HorizontalTextAlignment="Center" TextColor="{DynamicResource ColorPrimarioTexto}" />
                    </VerticalStackLayout>
                </Border>
                <!-- Brillo suave arriba: da volumen sin depender del color de la marca -->
                <Ellipse x:Name="Brillo" WidthRequest="200" HeightRequest="200" InputTransparent="True">
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#33FFFFFF" Offset="0.0" />
                            <GradientStop Color="#00FFFFFF" Offset="0.6" />
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <ActivityIndicator IsRunning="{Binding Procesando}"
                                   IsVisible="{Binding Procesando}"
                                   Color="{DynamicResource ColorAcento}"
                                   WidthRequest="48" HeightRequest="48"
                                   VerticalOptions="End" Margin="0,0,0,24"
                                   InputTransparent="True" />
            </Grid>

            <Label x:Name="AvisoPermisos" Text="Se pedirá tu ubicación y tu huella o PIN del teléfono solo al fichar."
                   HorizontalTextAlignment="Center"
                   FontSize="12"
                   TextColor="{DynamicResource ColorTextoSuave}" />
        </VerticalStackLayout>

        <VerticalStackLayout x:Name="Pie" Grid.Row="2" Margin="24,0,24,24" Spacing="12">

            <!-- Confirmación grande del fichaje registrado -->
            <Border IsVisible="{Binding ConfirmacionVisible}" Padding="20,18"
                    BackgroundColor="#EEF3E2" Stroke="#4E7A2F" StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="4">
                    <Label Text="✓" FontSize="36" FontAttributes="Bold" TextColor="#4E7A2F" HorizontalOptions="Center" />
                    <Label Text="{Binding ConfirmacionTexto}" FontSize="18" FontAttributes="Bold"
                           HorizontalTextAlignment="Center" TextColor="#33501C" />
                </VerticalStackLayout>
            </Border>

            <!-- Error del último intento -->
            <ctl:BannerInline Severidad="Error" Texto="{Binding Estado}" IsVisible="{Binding HayError}" />

            <!-- Avance ("Obteniendo ubicación…") -->
            <Border IsVisible="{Binding HayEstado}" Padding="16,12"
                    BackgroundColor="{DynamicResource ColorSuperficie}"
                    Stroke="{DynamicResource ColorBorde}"
                    StrokeShape="RoundRectangle 14">
                <Label Text="{Binding Estado}"
                       HorizontalTextAlignment="Center"
                       TextColor="{DynamicResource ColorTexto}" />
            </Border>

            <!-- Aparece después de un fichaje exitoso -->
            <Button BackgroundColor="{DynamicResource ColorPrimario}" TextColor="{DynamicResource ColorPrimarioTexto}" Text="Ver en Google Maps"
                    Clicked="OnAbrirMapsClicked"
                    IsVisible="{Binding MostrarMapa}" />

            <!-- Esta pantalla no tiene barra superior: el supervisor/administrador vuelve a su panel desde acá -->
            <Button BackgroundColor="{DynamicResource ColorPrimario}" TextColor="{DynamicResource ColorPrimarioTexto}" x:Name="PanelButton" Text="Volver a mi panel" Clicked="OnVolverAlPanel" IsVisible="False" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button BackgroundColor="{DynamicResource ColorPrimario}" TextColor="{DynamicResource ColorPrimarioTexto}" x:Name="PinButton" Text="Cambiar PIN" Clicked="OnCambiarPin" IsVisible="False" />
                <Button BackgroundColor="{DynamicResource ColorPrimario}" TextColor="{DynamicResource ColorPrimarioTexto}" Grid.Column="1" Text="Cerrar sesión" Clicked="OnCerrarSesion" />
            </Grid>
        </VerticalStackLayout>
    </Grid>
    </ScrollView>
</ContentPage>
