<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ctl="clr-namespace:FichajeApp.Mobile.Views.Componentes"
             x:Class="FichajeApp.Mobile.Views.FichajesAdminPage"
             Title="Corregir fichajes"
             BackgroundColor="{DynamicResource ColorFondo}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16" RowSpacing="8">

        <VerticalStackLayout Spacing="8">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <DatePicker Date="{Binding Desde}" />
                <DatePicker Grid.Column="1" Date="{Binding Hasta}" />
            </Grid>
            <HorizontalStackLayout Spacing="8">
                <Switch IsToggled="{Binding SoloVencidos}" />
                <Label Text="Solo entradas vencidas" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Button Text="Buscar" Clicked="OnBuscar" />
        </VerticalStackLayout>

        <Label Grid.Row="1" Text="{Binding Estado}" FontSize="12" />

        <CollectionView Grid.Row="2" ItemsSource="{Binding Incompletos}" SelectionMode="Single" SelectionChanged="OnSeleccion">
            <CollectionView.EmptyView>
                <ctl:EstadoVacio Icono="✅" Titulo="No hay fichajes para corregir" Mensaje="Todas las entradas y salidas están completas." />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <ctl:ItemDeLista Titulo="{Binding Empleado}" Detalle="{Binding Resumen}" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="3" Spacing="8">
            <Button Text="Cargar un fichaje que faltó" Clicked="OnManual" />
            <ActivityIndicator IsRunning="{Binding Procesando}" IsVisible="{Binding Procesando}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
