<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ctl="clr-namespace:FichajeApp.Mobile.Views.Componentes"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             xmlns:iconos="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
             x:Class="FichajeApp.Mobile.Views.LoginPage"
             Title="Iniciar sesión"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource ColorFondo}">

    <!-- Con pantalla chica o letra grande el formulario no entra: se puede deslizar para llegar al botón -->
    <ScrollView>
    <Grid RowDefinitions="Auto,*">

        <!-- Cabecera con la identidad del cliente -->
        <VerticalStackLayout Grid.Row="0"
                             BackgroundColor="{DynamicResource ColorPrimario}"
                             Padding="24,64,24,56"
                             Spacing="12">
            <!-- El logo se muestra redondo (círculo), también el que sube el administrador desde Apariencia.
                 Ajuste oculto: 5 toques seguidos permiten cambiar la dirección del servidor (ver OnLogoTapped) -->
            <Border WidthRequest="84" HeightRequest="84" HorizontalOptions="Center"
                    StrokeShape="Ellipse" StrokeThickness="0" Padding="0" BackgroundColor="White">
                <Image Source="{DynamicResource LogoCliente}" Aspect="AspectFill" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnLogoTapped" />
                </Border.GestureRecognizers>
            </Border>
            <Label Text="{DynamicResource NombreCliente}"
                   TextColor="{DynamicResource ColorPrimarioTexto}"
                   FontSize="26" FontAttributes="Bold"
                   HorizontalOptions="Center" />
            <Label Text="Control de asistencia"
                   TextColor="{DynamicResource ColorPrimarioTexto}"
                   Opacity="0.85" FontSize="14"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Formulario superpuesto a la cabecera -->
        <Border Grid.Row="1"
                Margin="24,-32,24,0"
                Padding="24"
                VerticalOptions="Start"
                BackgroundColor="{DynamicResource ColorSuperficie}"
                Stroke="{DynamicResource ColorBorde}"
                StrokeShape="RoundRectangle 20">
            <VerticalStackLayout Spacing="16">

                <Label Text="Iniciar sesión" FontSize="20" FontAttributes="Bold"
                       TextColor="{DynamicResource ColorTexto}" />

                <material:TextField Title="Email" Keyboard="Email" Text="{Binding Email}">
                    <material:TextField.Icon>
                        <FontImageSource FontFamily="MaterialOutlined" Glyph="{x:Static iconos:MaterialOutlined.Mail}"
                                         Color="{DynamicResource ColorTextoSuave}" />
                    </material:TextField.Icon>
                </material:TextField>

                <material:TextField Title="PIN" IsPassword="True" Keyboard="Numeric" MaxLength="4"
                                    ReturnType="Done" Completed="OnPinCompleted" Text="{Binding Pin}">
                    <material:TextField.Icon>
                        <FontImageSource FontFamily="MaterialOutlined" Glyph="{x:Static iconos:MaterialOutlined.Lock}"
                                         Color="{DynamicResource ColorTextoSuave}" />
                    </material:TextField.Icon>
                </material:TextField>

                <!-- Solo con huella, rostro o bloqueo de pantalla en el teléfono -->
                <HorizontalStackLayout Spacing="8" IsVisible="{Binding HuellaDisponible}">
                    <CheckBox IsChecked="{Binding Recordar}" VerticalOptions="Center" />
                    <Label Text="Recordar mis datos y entrar con huella" VerticalOptions="Center"
                           TextColor="{DynamicResource ColorTexto}" FontSize="13" />
                </HorizontalStackLayout>

                <Button Text="Ingresar"
                        HeightRequest="50"
                        FontAttributes="Bold"
                        BackgroundColor="{DynamicResource ColorPrimario}"
                        TextColor="{DynamicResource ColorPrimarioTexto}"
                        Clicked="OnLoginClicked"
                        IsEnabled="{Binding Procesando, Converter={StaticResource InvertedBoolConverter}}" />

                <Button Text="Entrar con huella"
                        IsVisible="{Binding PuedeUsarHuella}"
                        BackgroundColor="Transparent"
                        BorderColor="{DynamicResource ColorPrimario}" BorderWidth="1"
                        TextColor="{DynamicResource ColorPrimario}"
                        Clicked="OnHuellaClicked"
                        IsEnabled="{Binding Procesando, Converter={StaticResource InvertedBoolConverter}}" />

                <Button Text="Olvidé mi PIN" Clicked="OnOlvidePinClicked"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource ColorTextoSuave}"
                        FontSize="13" />

                <ActivityIndicator IsRunning="{Binding Procesando}"
                                   IsVisible="{Binding Procesando}"
                                   Color="{DynamicResource ColorPrimario}" />

                <ctl:BannerInline Severidad="Error" Texto="{Binding Estado}" IsVisible="{Binding HayError}" />

                <Label x:Name="ServidorLabel" IsVisible="False" FontSize="11"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center"
                       TextColor="{DynamicResource ColorTextoSuave}" />

                <Button x:Name="ConectarButton" Text="Conectar mi planilla de Google"
                        Clicked="OnConfigurarClicked"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource ColorTextoSuave}"
                        FontSize="12" />

            </VerticalStackLayout>
        </Border>
    </Grid>
    </ScrollView>
</ContentPage>
