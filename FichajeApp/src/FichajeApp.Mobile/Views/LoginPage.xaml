<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FichajeApp.Mobile.Views.LoginPage"
             Title="Iniciar sesión">

    <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

        <Label Text="Fichaje - Iniciar sesión" FontSize="24" HorizontalOptions="Center" />

        <Entry Placeholder="Email"
               Keyboard="Email"
               Text="{Binding Email}" />

        <Entry Placeholder="PIN"
               IsPassword="True"
               Keyboard="Numeric"
               MaxLength="4"
               Text="{Binding Pin}" />

        <Button Text="Ingresar"
                Clicked="OnLoginClicked"
                IsEnabled="{Binding Procesando, Converter={StaticResource InvertedBoolConverter}}" />

        <ActivityIndicator IsRunning="{Binding Procesando}" IsVisible="{Binding Procesando}" />

        <Label Text="{Binding Estado}" HorizontalOptions="Center" />

    </VerticalStackLayout>
</ContentPage>
