<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ctl="clr-namespace:FichajeApp.Mobile.Views.Componentes"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
             x:Class="FichajeApp.Mobile.Views.SupervisorPage"
             Title="Supervisor"
             BackgroundColor="{DynamicResource ColorFondo}">

    <Grid RowDefinitions="Auto,Auto,2*,Auto,Auto,3*" RowSpacing="10" Padding="16">

        <!-- Modo de consulta: el activo se ve relleno, los otros con borde -->
        <Grid Grid.Row="0" ColumnDefinitions="*,*,*" ColumnSpacing="8">
            <Button Grid.Column="0" Text="Hoy" Clicked="OnHoyClicked" Style="{StaticResource BotonCompacto}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding EsHoy}" Value="True">
                        <Setter Property="BackgroundColor" Value="{DynamicResource ColorPrimario}" />
                        <Setter Property="TextColor" Value="{DynamicResource ColorPrimarioTexto}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Column="1" Text="Presentes" Clicked="OnPresentesClicked" Style="{StaticResource BotonCompacto}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding EsPresentes}" Value="True">
                        <Setter Property="BackgroundColor" Value="{DynamicResource ColorPrimario}" />
                        <Setter Property="TextColor" Value="{DynamicResource ColorPrimarioTexto}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Column="2" Text="Historial" Clicked="OnHistorialClicked" Style="{StaticResource BotonCompacto}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding EsHistorial}" Value="True">
                        <Setter Property="BackgroundColor" Value="{DynamicResource ColorPrimario}" />
                        <Setter Property="TextColor" Value="{DynamicResource ColorPrimarioTexto}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </Grid>

        <!-- Filtros: solo en Historial -->
        <Border Grid.Row="1" Style="{StaticResource Tarjeta}" Padding="12" IsVisible="{Binding EsHistorial}">
            <VerticalStackLayout Spacing="8">
                <Label Text="FILTROS" Style="{StaticResource EncabezadoSeccion}" Margin="0" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Border Grid.Column="0" Style="{StaticResource Campo}"><DatePicker Date="{Binding Desde}" /></Border>
                    <Border Grid.Column="1" Style="{StaticResource Campo}"><DatePicker Date="{Binding Hasta}" /></Border>
                </Grid>
                <Border Style="{StaticResource Campo}"><Picker Title="Empleado"
                        ItemsSource="{Binding Empleados}"
                        SelectedItem="{Binding EmpleadoSeleccionado}" /></Border>
                <HorizontalStackLayout Spacing="8">
                    <Switch IsToggled="{Binding UnirRecorrido}" VerticalOptions="Center" />
                    <Label Text="Unir los puntos con una línea" VerticalOptions="Center" FontSize="14" />
                </HorizontalStackLayout>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="Buscar" Clicked="OnBuscarClicked" />
                    <Button Grid.Column="1" Text="Ver recorrido" Clicked="OnVerRecorridoClicked" Style="{StaticResource BotonSecundario}" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Tarjeta}" Padding="0" StrokeShape="RoundRectangle 16">
            <Grid>
                <mapsui:MapView x:Name="Mapa" />
                <Button Text="Ver todos" Clicked="OnVerTodosClicked" HorizontalOptions="Start" VerticalOptions="Start" Margin="8"
                        Padding="12,0" HeightRequest="36" FontSize="13" Style="{StaticResource BotonSecundario}" BackgroundColor="#E6FFFFFF" />
            </Grid>
        </Border>

        <Label Grid.Row="3" Text="{Binding Estado}" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource ColorTextoSuave}"
               HorizontalOptions="Center" HorizontalTextAlignment="Center" />

        <!-- Detalle del fichaje elegido: quién, cuándo y dónde, con la foto y Google Maps a un toque -->
        <Border x:Name="DetalleCard" Grid.Row="4" Style="{StaticResource Tarjeta}" Padding="14" IsVisible="False">
            <VerticalStackLayout Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <Label x:Name="DetalleTitulo" FontSize="17" FontAttributes="Bold" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="✕" FontSize="20" Padding="8,0" TextColor="{DynamicResource ColorTextoSuave}" VerticalOptions="Center">
                        <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnCerrarDetalle" /></Label.GestureRecognizers>
                    </Label>
                </Grid>
                <Label x:Name="DetalleTexto" FontSize="13" TextColor="{DynamicResource ColorTextoSuave}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,4,0,0">
                    <Button x:Name="MapsButton" Grid.Column="0" Text="Ver en Google Maps" Clicked="OnVerEnMapsClicked" FontSize="13" />
                    <Button x:Name="FotoButton" Grid.Column="1" Text="Ver foto" Clicked="OnVerFotoClicked" Style="{StaticResource BotonSecundario}" FontSize="13" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- Deslizar hacia abajo actualiza; además se actualiza sola cada 30 s -->
        <RefreshView Grid.Row="5" Command="{Binding RefrescarCommand}" IsRefreshing="{Binding Refrescando}">
            <CollectionView ItemsSource="{Binding Items}"
                            SelectionMode="Single"
                            SelectionChanged="OnItemSelected">
                <CollectionView.EmptyView>
                    <ctl:EstadoVacio Icono="🕒" Titulo="No hay fichajes para mostrar" Mensaje="Probá con otra fecha o con otra persona." />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <!-- Tarjeta con una franja de color: verde entrada, ámbar salida -->
                        <Border Style="{StaticResource Tarjeta}" Margin="0,4" Padding="12">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{DynamicResource ColorSuperficie}" />
                                            <Setter Property="Stroke" Value="{DynamicResource ColorPrimario}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid ColumnDefinitions="6,*,Auto" ColumnSpacing="12">
                                <BoxView WidthRequest="6" CornerRadius="3" Color="#4E7A2F">
                                    <BoxView.Triggers>
                                        <DataTrigger TargetType="BoxView" Binding="{Binding TipoFichaje}" Value="Salida">
                                            <Setter Property="Color" Value="#8B5A2B" />
                                        </DataTrigger>
                                    </BoxView.Triggers>
                                </BoxView>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding NombreCompleto}" FontSize="16" FontAttributes="Bold" />
                                    <Label Text="{Binding Resumen}" Style="{StaticResource TextoAclaracion}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="{Binding TipoFichaje}" FontSize="13" FontAttributes="Bold"
                                       TextColor="#4E7A2F" VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding TipoFichaje}" Value="Salida">
                                            <Setter Property="TextColor" Value="#8B5A2B" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
