<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ctl="clr-namespace:FichajeApp.Mobile.Views.Componentes"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             x:Class="FichajeApp.Mobile.Views.SupervisorPage"
             Title="Supervisor"
             BackgroundColor="{DynamicResource ColorFondo}">

    <Grid RowDefinitions="Auto,Auto,2*,Auto,3*" RowSpacing="8" Padding="12">

        <!-- Modo de consulta: el activo se ve relleno, los otros con borde -->
        <Grid Grid.Row="0" ColumnDefinitions="*,*,*" ColumnSpacing="8">
            <Button Grid.Column="0" Text="Hoy" Clicked="OnHoyClicked" Style="{StaticResource BotonSecundario}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding EsHoy}" Value="True">
                        <Setter Property="BackgroundColor" Value="{DynamicResource ColorPrimario}" />
                        <Setter Property="TextColor" Value="{DynamicResource ColorPrimarioTexto}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Column="1" Text="Presentes" Clicked="OnPresentesClicked" Style="{StaticResource BotonSecundario}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding EsPresentes}" Value="True">
                        <Setter Property="BackgroundColor" Value="{DynamicResource ColorPrimario}" />
                        <Setter Property="TextColor" Value="{DynamicResource ColorPrimarioTexto}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Column="2" Text="Historial" Clicked="OnHistorialClicked" Style="{StaticResource BotonSecundario}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding EsHistorial}" Value="True">
                        <Setter Property="BackgroundColor" Value="{DynamicResource ColorPrimario}" />
                        <Setter Property="TextColor" Value="{DynamicResource ColorPrimarioTexto}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </Grid>

        <!-- Filtros: solo en Historial -->
        <VerticalStackLayout Grid.Row="1" Spacing="4" IsVisible="{Binding EsHistorial}">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                <DatePicker Grid.Column="0" Date="{Binding Desde}" />
                <DatePicker Grid.Column="1" Date="{Binding Hasta}" />
            </Grid>
            <Picker Title="Empleado"
                    ItemsSource="{Binding Empleados}"
                    SelectedItem="{Binding EmpleadoSeleccionado}" />
            <HorizontalStackLayout Spacing="8">
                <Switch IsToggled="{Binding UnirRecorrido}" />
                <Label Text="Unir con línea (recorrido de una persona)" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Button Text="Buscar" Clicked="OnBuscarClicked" />
        </VerticalStackLayout>

        <Border Grid.Row="2" Style="{StaticResource Tarjeta}" Padding="0" StrokeShape="RoundRectangle 16">
            <Grid>
                <maps:Map x:Name="Mapa" />
                <!-- Sin clave de Google Maps el mapa no dibuja nada: se avisa en vez de dejar un recuadro vacío -->
                <ctl:BannerInline x:Name="AvisoMapa" IsVisible="False" Severidad="Aviso" Margin="10" VerticalOptions="Start"
                                  Texto="Falta la clave de Google Maps en esta versión de la app: el mapa no puede cargar. La lista de abajo funciona igual." />
            </Grid>
        </Border>

        <Label Grid.Row="3" Text="{Binding Estado}" Style="{StaticResource TextoAclaracion}" HorizontalOptions="Center"
               HorizontalTextAlignment="Center" />

        <!-- Deslizar hacia abajo actualiza; además se actualiza sola cada 30 s -->
        <RefreshView Grid.Row="4" Command="{Binding RefrescarCommand}" IsRefreshing="{Binding Refrescando}">
            <CollectionView ItemsSource="{Binding Items}"
                            SelectionMode="Single"
                            SelectionChanged="OnItemSelected">
                <CollectionView.EmptyView>
                    <ctl:EstadoVacio Icono="🕒" Titulo="No hay fichajes para mostrar" Mensaje="Probá con otra fecha o con otra persona." />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <ctl:ItemDeLista Titulo="{Binding NombreCompleto}" Detalle="{Binding Resumen}" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
