<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ctl="clr-namespace:FichajeApp.Mobile.Views.Componentes"
             x:Class="FichajeApp.Mobile.Views.SitiosPage"
             Title="Lugares conocidos"
             BackgroundColor="{DynamicResource ColorFondo}">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="16" RowSpacing="8">

        <Label Text="Los lugares donde se puede fichar sin dar explicaciones. Fuera de ellos, la persona tiene que escribir un motivo."
               Style="{StaticResource TextoAclaracion}" />

        <Button Grid.Row="1" Text="Agregar lugar" Clicked="OnAgregar" />

        <Label Grid.Row="2" Text="{Binding Estado}" FontSize="12" />

        <CollectionView Grid.Row="3" ItemsSource="{Binding Sitios}" SelectionMode="Single" SelectionChanged="OnSeleccion">
            <CollectionView.EmptyView>
                <ctl:EstadoVacio Icono="📍" Titulo="Todavía no hay lugares"
                                 Mensaje="Agregá la sede estando ahí: la app toma tu ubicación y todos los que fichen cerca no tienen que escribir un motivo." />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <ctl:ItemDeLista Titulo="{Binding Nombre}" Detalle="{Binding Detalle}" ConAvatar="False" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator Grid.Row="4" IsRunning="{Binding Procesando}" IsVisible="{Binding Procesando}" />
    </Grid>
</ContentPage>
