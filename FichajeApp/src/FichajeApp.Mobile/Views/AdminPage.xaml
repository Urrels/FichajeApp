<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FichajeApp.Mobile.Views.AdminPage"
             Title="Administración">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14">

            <Label x:Name="SaludoLabel" FontSize="20" FontAttributes="Bold" />
            <Label Text="Solo ves lo que tu rol te permite." FontSize="12" />

            <Button x:Name="UsuariosButton" Text="Usuarios" Clicked="OnUsuarios" IsVisible="False" />
            <Button x:Name="RolesButton" Text="Roles y permisos" Clicked="OnRoles" IsVisible="False" />
            <Button x:Name="BitacoraButton" Text="Bitácora" Clicked="OnBitacora" IsVisible="False" />
            <Button x:Name="FichajesButton" Text="Corregir fichajes" Clicked="OnFichajes" IsVisible="False" />
            <Button x:Name="LiquidacionButton" Text="Liquidación de horas" Clicked="OnLiquidacion" IsVisible="False" />
            <Button x:Name="AparienciaButton" Text="Apariencia" Clicked="OnApariencia" IsVisible="False" />
            <Button x:Name="ConfigFichajeButton" Text="Cómo se ficha (ubicación y foto)" Clicked="OnConfigFichaje" IsVisible="False" />

            <BoxView HeightRequest="1" Color="Gray" Opacity="0.4" />

            <Button x:Name="PinButton" Text="Cambiar mi PIN" Clicked="OnCambiarPin" IsVisible="False" />
            <Button Text="Cerrar sesión" Clicked="OnCerrarSesion" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
