<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FichajeApp.Mobile.Views.RolesPage"
             Title="Roles y permisos">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="12" RowSpacing="8">

        <Button Text="Nuevo rol" Clicked="OnNuevo" />

        <Label Grid.Row="1" Text="{Binding Estado}" FontSize="12" />

        <CollectionView Grid.Row="2" ItemsSource="{Binding Roles}" SelectionMode="Single" SelectionChanged="OnSeleccion">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Padding="6,6">
                        <Label Text="{Binding Texto}" FontAttributes="Bold" LineBreakMode="NoWrap" />
                        <Label Text="{Binding Detalle}" FontSize="12" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator Grid.Row="3" IsRunning="{Binding Procesando}" IsVisible="{Binding Procesando}" />
    </Grid>
</ContentPage>
