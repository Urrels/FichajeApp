<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FichajeApp.Mobile.Views.AyudaClavePage"
             Title="Clave de instalación"
             BackgroundColor="{DynamicResource ColorFondo}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="¿Dónde consigo la clave?" FontSize="20" FontAttributes="Bold" />
            <Label FontSize="13"
                   Text="La clave de instalación es una contraseña que protege la conexión con tu planilla. No es tu PIN ni tu contraseña de Google. Se la da a cada cliente quien instaló el servidor: si es tu caso, pedísela. Si instalaste el servidor vos, la conseguís de cualquiera de estas tres formas." />

            <!-- Opción 1 -->
            <Border Padding="12" StrokeShape="RoundRectangle 12" BackgroundColor="{DynamicResource ColorSuperficie}" Stroke="{DynamicResource ColorBorde}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Opción 1 · En la consola de la API" FontAttributes="Bold" />
                    <Label FontSize="13" Text="1. Iniciá la API (la ventana negra de consola o la salida de Visual Studio)." />
                    <Label FontSize="13" Text="2. Buscá el aviso amarillo que dice «Clave de instalación para la app» y copiá el código que sigue." />
                    <Image Source="ayuda_log.png" Aspect="AspectFit" HeightRequest="170" />
                    <Label FontSize="11" Text="Solo aparece mientras el servidor no tiene planilla conectada." />
                </VerticalStackLayout>
            </Border>

            <!-- Opción 2 -->
            <Border Padding="12" StrokeShape="RoundRectangle 12" BackgroundColor="{DynamicResource ColorSuperficie}" Stroke="{DynamicResource ColorBorde}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Opción 2 · En un archivo del servidor" FontAttributes="Bold" />
                    <Label FontSize="13" Text="1. Abrí la carpeta de la API en el servidor y entrá a «datos»." />
                    <Label FontSize="13" Text="2. Abrí «clave-instalacion.txt» con el Bloc de notas. El texto es la clave." />
                    <Image Source="ayuda_archivo.png" Aspect="AspectFit" HeightRequest="170" />
                </VerticalStackLayout>
            </Border>

            <!-- Opción 3 -->
            <Border Padding="12" StrokeShape="RoundRectangle 12" BackgroundColor="{DynamicResource ColorSuperficie}" Stroke="{DynamicResource ColorBorde}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Opción 3 · Elegirla vos" FontAttributes="Bold" />
                    <Label FontSize="13" Text="1. Abrí el archivo de configuración de la API (appsettings.Development.json o appsettings.json)." />
                    <Label FontSize="13" Text="2. Agregá el bloque «Setup» con la clave que quieras, guardá y reiniciá la API." />
                    <Image Source="ayuda_config.png" Aspect="AspectFit" HeightRequest="170" />
                    <Label FontSize="11" Text="En un servidor en internet se hace con la variable de entorno Setup__Clave." />
                </VerticalStackLayout>
            </Border>

            <Label FontAttributes="Bold" Text="Para tener en cuenta" Margin="0,6,0,0" />
            <Label FontSize="13" Text="• Escribila tal cual: distingue mayúsculas de minúsculas." />
            <Label FontSize="13" Text="• Si la escribís mal varias veces, la app te pide esperar un minuto." />
            <Label FontSize="13" Text="• No la compartas con nadie que no deba cambiar la conexión de la planilla." />

            <Button Text="Entendido, volver" Clicked="OnVolver" Margin="0,8,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
