<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Solo Android: Play Store exige apuntar a Android 16 (API 36), que en .NET existe desde .NET 10 + MAUI 10.
		     Fijar el 36.0 hace que el build falle, en vez de cambiar de API sin avisar, al pasar a otro .NET. -->
		<TargetFrameworks>net10.0-android36.0</TargetFrameworks>
		<!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com/Samsung/Tizen.NET -->
		<!-- <TargetFrameworks>$(TargetFrameworks);net8.0-tizen</TargetFrameworks> -->

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>FichajeApp.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>FichajeApp.Mobile</ApplicationTitle>
			<!-- Cliente de este build (carpeta Clientes\<cliente>): ícono, logo, colores y URL de la API.
			     Se cambia con: dotnet publish -p:Cliente=clientea. Ver FichajeApp.Mobile.Clientes.csproj.snippet.txt -->
			<Cliente Condition="'$(Cliente)' == ''">dev</Cliente>

		<!-- Fast Deployment falla en este emulador (XA0137, run-as): se empaquetan los assemblies en el APK -->
		<EmbedAssembliesIntoApk Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">true</EmbedAssembliesIntoApk>

		<!-- Sin Package.appxmanifest, la app de Windows se compila sin empaquetar (si no, falla con
		     "no AppxManifest is specified, but WindowsPackageType is not set to MSIX") -->
		<WindowsPackageType Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">None</WindowsPackageType>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.fichajeapp.mobile</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.1</ApplicationDisplayVersion>
		<ApplicationVersion>2</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">11.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">13.1</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
	</PropertyGroup>

	<!-- Identidad de la app por cliente: ApplicationId y título son lo que ve Play Store y el launcher.
	     Cambiar el ApplicationId por el dominio propio ANTES de publicar: no se puede cambiar después. -->
	<PropertyGroup Condition="'$(Cliente)' == 'dev'">
		<ApplicationId>io.github.urrels.fichaje.dev</ApplicationId>
		<ApplicationTitle>Fichaje (dev)</ApplicationTitle>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Cliente)' == 'clientea'">
		<!-- Identificador que va a Play Store: PERMANENTE desde la primera subida. El Cliente sigue llamándose "clientea" para el
		     keystore y la carpeta, pero eso no se ve en la tienda. -->
		<ApplicationId>io.github.urrels.fichaje</ApplicationId>
		<ApplicationTitle>HoraTrack</ApplicationTitle>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Cliente)' == 'clienteb'">
		<ApplicationId>io.github.urrels.fichaje.clienteb</ApplicationId>
		<ApplicationTitle>Fichaje Cliente B</ApplicationTitle>
	</PropertyGroup>

	<!-- Release para Play Store: un .aab firmado con el keystore del cliente (keystores\<cliente>.keystore).
	     Las contraseñas NO van acá: se pasan por línea de comandos (ver docs/PLAY_STORE.md) -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<AndroidPackageFormat>aab</AndroidPackageFormat>
		<AndroidKeyStore>True</AndroidKeyStore>
		<AndroidSigningKeyStore>keystores\$(Cliente).keystore</AndroidSigningKeyStore>
		<AndroidSigningKeyAlias>$(Cliente)</AndroidSigningKeyAlias>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Clientes\$(Cliente)\appicon.svg" ForegroundFile="Clientes\$(Cliente)\appiconfg.svg" Color="#B5542B" />
			<!-- Logo de la cabecera y configuración del cliente (nombre, URL de la API y colores) -->
			<MauiImage Include="Clientes\$(Cliente)\logo.svg" Link="Resources\Images\logo.svg" BaseSize="96,96" />
			<EmbeddedResource Include="Clientes\$(Cliente)\cliente.json" LogicalName="cliente.json" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#B5542B" BaseSize="128,128" />

		<!-- Ilustraciones de la ayuda de la clave de instalación -->
		<!-- Son PNG ya dibujados desde los .svg de la misma carpeta: el generador de imágenes de MAUI 10 falla con SVG que tienen texto -->
		<MauiImage Include="Resources\Ayuda\*.png" Resize="False" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
	  <None Remove="Platforms\Android\Resources\xml\network_security_config.xml" />
	</ItemGroup>

	<!-- Notificaciones push: el archivo google-services.json se baja de la consola de Firebase (Configuración del proyecto → tu app Android)
	     y se deja en esta carpeta. No va al repositorio (ver .gitignore). Sin él la app compila y funciona, solo que sin push. -->
	<ItemGroup Condition="Exists('google-services.json')">
		<GoogleServicesJson Include="google-services.json" />
	</ItemGroup>
	<!-- El procesamiento de google-services.json es incremental y no mira el ApplicationId: al pasar de la versión de desarrollo
	     (io.github.urrels.fichaje.dev, sin entrada en el JSON) a la real, se reutilizaba un resultado sin google_app_id y Firebase
	     no arrancaba ("no default options were found"). Se borra el sello para que se vuelva a generar siempre. -->
	<Target Name="RegenerarFirebaseSiCambiaElPaquete" BeforeTargets="ProcessGoogleServicesJson" Condition="'@(GoogleServicesJson)' != ''">
		<Delete Files="$(IntermediateOutputPath)googsvcsjson.stamp" />
	</Target>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="15.0.1" />
		<PackageReference Include="CommunityToolkit.Maui.Camera" Version="6.1.0" />
		<PackageReference Include="Mapsui.Maui" Version="5.1.0" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" />
			<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="Plugin.Fingerprint" Version="2.1.5" />
		<PackageReference Include="Xamarin.Firebase.Messaging" Version="125.1.3" />
		<!-- Detección de caras en el teléfono (ML Kit, modelo incluido en la app: funciona sin internet) para validar la foto de perfil -->
		<PackageReference Include="Xamarin.Google.MLKit.FaceDetection" Version="116.1.7.9" />
		<!-- ML Kit arrastra versiones viejas de estas dos; con la 1.9 de Fragment que ya usa MAUI aparecen clases duplicadas -->
		<PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.1" />
		<PackageReference Include="Xamarin.AndroidX.Collection.Ktx" Version="1.6.0.1" />
		<!-- Mapsui arrastra SkiaSharp 2.88 y HarfBuzzSharp 2.8: el generador de imágenes de MAUI 10 necesita las 3.x / 8.3 -->
		<PackageReference Include="SkiaSharp" Version="3.119.2" />
		<PackageReference Include="SkiaSharp.HarfBuzz" Version="3.119.2" />
		<PackageReference Include="HarfBuzzSharp" Version="8.3.1.3" />
		<PackageReference Include="UraniumUI.Icons.MaterialSymbols" Version="3.0.0" />
		<PackageReference Include="UraniumUI.Material" Version="3.0.0" />
	</ItemGroup>

</Project>
