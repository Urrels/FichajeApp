<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:FichajeApp.Mobile.Views"
       x:Class="FichajeApp.Mobile.AppShell"
       Shell.BackgroundColor="{DynamicResource ColorPrimario}"
       Shell.ForegroundColor="{DynamicResource ColorPrimarioTexto}"
       Shell.TitleColor="{DynamicResource ColorPrimarioTexto}"
       FlyoutBackgroundColor="{DynamicResource ColorSuperficie}">

    <!-- Menú lateral en tonos cálidos: el ítem actual se marca con arena en vez del gris de la plantilla -->
    <!-- Cabecera del menú: quién tiene la sesión abierta y con qué rol (se completa en AppShell.xaml.cs) -->
    <Shell.FlyoutHeader>
        <VerticalStackLayout BackgroundColor="{DynamicResource ColorPrimario}" Padding="20,48,20,20" Spacing="4">
            <Label x:Name="MenuNombre" Text="Fichaje" FontSize="20" FontAttributes="Bold" TextColor="{DynamicResource ColorPrimarioTexto}" />
            <Label x:Name="MenuRol" FontSize="13" Opacity="0.85" TextColor="{DynamicResource ColorPrimarioTexto}" />
        </VerticalStackLayout>
    </Shell.FlyoutHeader>

    <Shell.Resources>
        <!-- Letra más grande y oscura: antes el menú era chico y de bajo contraste -->
        <Style TargetType="Label" Class="FlyoutItemLabelStyle">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="TextColor" Value="{DynamicResource ColorTexto}" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style TargetType="Grid" Class="FlyoutItemLayoutStyle">
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="Transparent" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Selected">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#EADCCB" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </Shell.Resources>

    <!-- El login no es una opción del menú -->
    <ShellContent Title="Iniciar sesión"
                  Route="LoginPage"
                  FlyoutItemIsVisible="False"
                  ContentTemplate="{DataTemplate views:LoginPage}" />

    <ShellContent x:Name="FichajeItem"
                  Title="Fichar"
                  Route="FichajePage"
                  ContentTemplate="{DataTemplate views:FichajePage}" />

    <!-- Teléfono compartido de una sucursal: cada empleado ficha con su nombre y PIN -->
    <ShellContent Title="Kiosco"
                  Route="KioscoPage"
                  FlyoutItemIsVisible="False"
                  ContentTemplate="{DataTemplate views:KioscoPage}" />

    <!-- Solo visible para supervisores (ver AppShell.xaml.cs) -->
    <ShellContent x:Name="SupervisorItem"
                  Title="Supervisor"
                  Route="SupervisorPage"
                  FlyoutItemIsVisible="False"
                  ContentTemplate="{DataTemplate views:SupervisorPage}" />

    <!-- Solo visible para quien tiene algún permiso de administración (ver AppShell.xaml.cs) -->
    <ShellContent x:Name="AdminItem"
                  Title="Administración"
                  Route="AdminPage"
                  FlyoutItemIsVisible="False"
                  ContentTemplate="{DataTemplate views:AdminPage}" />

    <!-- Centro de notificaciones: solo con sesion iniciada (ver AppShell.xaml.cs) -->
    <MenuItem x:Name="NotifItem" Text="Notificaciones" Clicked="OnNotificaciones" Shell.FlyoutItemIsVisible="False" />

</Shell>
