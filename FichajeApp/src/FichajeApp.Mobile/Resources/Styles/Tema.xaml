<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material">

    <!-- Tokens de diseño. Los valores marcados "del cliente" se pisan al iniciar con los de
         Clientes/<cliente>/cliente.json y con lo que el administrador defina desde la app
         (ver ClienteService.AplicarTema). -->

    <x:String x:Key="NombreCliente">Fichaje</x:String>

    <!-- Los campos Material usan el color de la marca al enfocarse y un borde suave en reposo -->
    <Style TargetType="material:TextField">
        <Setter Property="AccentColor" Value="{DynamicResource ColorPrimario}" />
        <Setter Property="BorderColor" Value="{DynamicResource ColorBorde}" />
        <Setter Property="TextColor" Value="{DynamicResource ColorTexto}" />
    </Style>

    <!-- del cliente -->
    <Color x:Key="ColorPrimario">#7A2E3A</Color>
    <Color x:Key="ColorPrimarioTexto">#FFFFFF</Color>
    <Color x:Key="ColorAcento">#B88A4A</Color>
    <Color x:Key="ColorPrimarioOscuro">#5A1F29</Color>

    <!-- fijos -->
    <Color x:Key="ColorFondo">#F7F0E6</Color>
    <Color x:Key="ColorSuperficie">#FFFCF7</Color>
    <Color x:Key="ColorTexto">#2E211C</Color>
    <Color x:Key="ColorTextoSuave">#6B5648</Color>
    <Color x:Key="ColorBorde">#E3D5C3</Color>

    <!-- Estilos que reemplazan a los de la plantilla (Styles.xaml): usan el color del cliente y cambian en vivo.
         Se declaran acá, después de Styles.xaml, para que ganen. Los colores del estado "deshabilitado" van fijos
         para no depender de Colors.xaml. -->
    <Style TargetType="Button">
        <Setter Property="TextColor" Value="{DynamicResource ColorPrimarioTexto}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorPrimario}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
        <!-- Si el texto no entra (pantalla angosta o letra grande del sistema) pasa a dos renglones en vez de cortarse -->
        <Setter Property="LineBreakMode" Value="WordWrap" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="#6B5648" />
                            <Setter Property="BackgroundColor" Value="#DDCFBC" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver" />
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{DynamicResource ColorPrimario}" />
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{DynamicResource ColorPrimario}" />
    </Style>

    <!-- Textos: siempre oscuros sobre el fondo claro, sin depender del tema del teléfono -->
    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource ColorTexto}" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{DynamicResource ColorTexto}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource ColorTextoSuave}" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{DynamicResource ColorTexto}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource ColorTextoSuave}" />
    </Style>

    <!-- Fechas en el orden de Argentina (día/mes/año) y con el color de texto del tema -->
    <Style TargetType="DatePicker">
        <Setter Property="Format" Value="dd/MM/yyyy" />
        <Setter Property="TextColor" Value="{DynamicResource ColorTexto}" />
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="TextColor" Value="{DynamicResource ColorTexto}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource ColorTextoSuave}" />
    </Style>

    <!-- Escala de espacios (múltiplos de 4): usar solo estos valores para padding y márgenes -->
    <x:Double x:Key="Esp1">4</x:Double>
    <x:Double x:Key="Esp2">8</x:Double>
    <x:Double x:Key="Esp3">12</x:Double>
    <x:Double x:Key="Esp4">16</x:Double>
    <x:Double x:Key="Esp6">24</x:Double>
    <x:Double x:Key="Esp8">32</x:Double>

    <!-- Tarjeta: superficie blanca con borde fino y esquinas de 12. Un solo estilo en vez de repetir cuatro propiedades -->
    <Style x:Key="Tarjeta" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorSuperficie}" />
        <Setter Property="Stroke" Value="{DynamicResource ColorBorde}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Campo con borde para los controles nativos de Android (fecha, lista desplegable): así quedan alineados con el resto -->
    <Style x:Key="Campo" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorSuperficie}" />
        <Setter Property="Stroke" Value="{DynamicResource ColorBorde}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <!-- Botones: el principal es el de la marca (estilo implícito); estos son para lo secundario y lo destructivo -->
    <Style x:Key="BotonSecundario" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource ColorPrimario}" />
        <Setter Property="BorderColor" Value="{DynamicResource ColorPrimario}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <!-- Para filas de tres botones juntos: poco relleno y sin crecer con la letra del sistema, así la palabra entra entera -->
    <Style x:Key="BotonCompacto" TargetType="Button" BasedOn="{StaticResource BotonSecundario}">
        <Setter Property="Padding" Value="4,8" />
        <Setter Property="FontAutoScalingEnabled" Value="False" />
    </Style>

    <Style x:Key="BotonPeligro" TargetType="Button">
        <Setter Property="BackgroundColor" Value="#B02A37" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <!-- Tres niveles de texto: título, cuerpo (el predeterminado) y aclaración -->
    <Style x:Key="TextoTitulo" TargetType="Label">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource ColorTexto}" />
    </Style>

    <Style x:Key="TextoAclaracion" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{DynamicResource ColorTextoSuave}" />
    </Style>
    <!-- Encabezado de sección de un menú ("PERSONAS", "CONFIGURACIÓN"): chico, en mayúsculas y apagado -->
    <Style x:Key="EncabezadoSeccion" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="1" />
        <Setter Property="TextColor" Value="{DynamicResource ColorTextoSuave}" />
        <Setter Property="Margin" Value="0,12,0,0" />
    </Style>
</ResourceDictionary>
