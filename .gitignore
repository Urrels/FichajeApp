################################################################################
# Visual Studio + datos personales que NUNCA deben subirse al repositorio
################################################################################

/.vs
.vs/

# Compilación
bin/
obj/

# Archivos personales de Visual Studio
*.user
*.suo
launchSettings.json.user

# Credenciales de la cuenta de servicio de Google (secreto: da acceso a la planilla)
**/credentials/*.json

# Configuración local de cada desarrollador (ID de la planilla, administrador inicial, etc.)
# Se escribe en appsettings.Development.json en vez de modificar appsettings.json, que sí se versiona.
appsettings.Development.json

# Resultados de pruebas
TestResults/

# Conexion guardada desde la app (credencial cifrada, llaves y clave de instalacion)
**/FichajeApp.Api/datos/

# Llaves de firma de Play Store (NUNCA subir: si se pierden no se puede actualizar la app)
*.keystore
*.jks
**/keystores/
